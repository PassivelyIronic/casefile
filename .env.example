# casefile — environment variables
# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# Every variable read by src/casefile/config.py must be listed here.

# --- Chat provider (primary) -------------------------------------------------
# Provider id used by the provider abstraction: gemini | groq | openrouter | cloudflare | fake
CHAT_PROVIDER=gemini
# Model name for the primary provider (pick a free-tier model; chosen in Phase 0)
CHAT_MODEL=
# Google AI Studio API key (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Chat provider (fallback, optional) --------------------------------------
# Leave empty to disable the fallback. Same provider ids as CHAT_PROVIDER.
CHAT_FALLBACK_PROVIDER=
CHAT_FALLBACK_MODEL=
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cloudflare Workers AI: account id + API token with Workers AI permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Embeddings (local Ollama) -----------------------------------------------
# Embedding provider id: ollama | fake
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
# Ollama base URL (default local install)
OLLAMA_BASE_URL=http://localhost:11434

# --- Postgres (checkpointer + pgvector, from docker-compose) ------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=casefile
POSTGRES_USER=casefile
# Local-only password for the docker-compose database
POSTGRES_PASSWORD=casefile

# --- Langfuse (Cloud Hobby tier) ----------------------------------------------
# Keys from your Langfuse project settings: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Hugging Face (data snapshot, D-007) --------------------------------------
# Write token, only needed once to publish the snapshot: https://huggingface.co/settings/tokens
HF_TOKEN=
# Snapshot dataset and pinned revision (commit hash filled in after publishing)
HF_SNAPSHOT_REPO=passivelyironic/casefile-cfpb-snapshot
HF_SNAPSHOT_REVISION=

# --- Misc ----------------------------------------------------------------------
# Global seed for sampling and the synthetic account mock
CASEFILE_SEED=42
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
